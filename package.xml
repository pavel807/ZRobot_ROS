<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>zrobot</name>
  <version>1.0.0</version>
  <description>ZRobot - ROS2 Object Detection and Tracking Robot</description>
  <maintainer email="your@email.com">Your Name</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>zrobot_bringup</exec_depend>
  <exec_depend>zrobot_control</exec_depend>
  <exec_depend>zrobot_perception</exec_depend>
  <exec_depend>zrobot_obstacle_avoidance</exec_depend>
  <exec_depend>web_interface</exec_depend>
  <exec_depend>ldlidar_stl_ros2</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>